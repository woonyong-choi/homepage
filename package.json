    "diagramplay": "github:woonyong-choi/diagramplay#0a44d42eef40b7ecbf3121d34d9b1b1920b053aa",
    "document-engine": "github:woonyong-choi/document-engine#142a43b582b12e8dce46625f071f654f0e459ebb",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "katex": "^0.19.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": {
      ".": "$katex",
      "commander": "14.0.3"
    }
