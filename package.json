{
  "name": "homepage",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node src/build-publication.mjs",
    "check:tokens": "node scripts/audit-design.mjs",
    "check:product": "node --test src/*.test.mjs",
    "dev": "npm run build:site && node src/serve.mjs --port 8796 --root dist/site",
    "build:site": "node src/build-publication.mjs",
    "content:approve": "node src/approved-content.mjs approve",
    "content:revoke": "node src/approved-content.mjs revoke",
    "content:sync-vault": "node src/approved-content.mjs sync-vault",
    "content:sync": "node src/approved-content.mjs sync",
    "content:check": "node src/approved-content.mjs check"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@woonyong-choi/design-tokens": "github:woonyong-choi/design-tokens#8d065936c8eea1707bafa0cb438638240c302935",
    "diagramplay": "github:woonyong-choi/diagramplay#a80a6ca23ef3ba26948943d2d2327769363586e7",
    "document-engine": "github:woonyong-choi/document-engine#78e42ecf0cdfa1eda4dc65115b6f49a46f03556a",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "katex": "^0.19.0",
    "postcss": "8.5.29",
    "purgecss": "7.0.2",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "purgecss": {
      "glob": "13.0.6",
      "postcss-selector-parser": "7.1.6"
    },
    "katex": {
      ".": "$katex",
      "commander": "14.0.3"
    }
  }
}
