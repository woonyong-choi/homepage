{
  "name": "homepage",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node src/build-publication.mjs",
    "check:tokens": "node scripts/audit-design.mjs",
    "check:product": "node --test src/*.test.mjs",
    "dev": "npm run build:site && node src/serve.mjs --port 8796 --root dist/site",
    "build:site": "node src/build-publication.mjs",
    "content:approve": "node src/approved-content.mjs approve",
    "content:revoke": "node src/approved-content.mjs revoke",
    "content:sync": "node src/approved-content.mjs sync",
    "content:check": "node src/approved-content.mjs check",
    "design:sync": "node src/vendor/theme/ui/build/sync.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@vscode/markdown-it-katex": "^1.1.2",
    "daphnis": "github:woonyong-choi/daphnis#983bf00688f7ee9d64dece7d8f84eb50edd7009d",
    "esbuild": "0.28.2",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.2",
    "katex": "^0.19.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "postcss": "8.5.29",
    "purgecss": "7.0.2",
    "shiki": "4.5.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "purgecss": {
      "glob": "13.0.6",
      "postcss-selector-parser": "7.1.6"
    }
  }
}
