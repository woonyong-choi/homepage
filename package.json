{
  "name": "homepage",
  "private": true,
  "type": "module",
  "imports": {
    "#design/*": "./src/design/dist/*"
  },
  "scripts": {
    "prepare": "npm run build:design",
    "build:design": "node src/design/scripts/build.mjs",
    "build": "npm run build:design && node src/build-publication.mjs",
    "build:site": "npm run build:design && node src/build-publication.mjs",
    "dev": "npm run build:site && node src/serve.mjs --port 8796 --root dist/site",
    "check:tokens": "npm run build:design && node scripts/audit-design.mjs",
    "check:product": "npm run build:design && node --test src/*.test.mjs src/document/test/*.test.js src/design/test/*.test.js",
    "content:sync-vault": "node src/approved-content.mjs sync-vault",
    "content:check": "node src/approved-content.mjs check"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@vscode/markdown-it-katex": "1.1.2",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "jsdom": "29.1.1",
    "katex": "^0.19.0",
    "markdown-it": "15.0.3",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "postcss": "^8.5.29",
    "purgecss": "^7.0.2",
    "shiki": "4.5.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": {
      ".": "$katex",
      "commander": "14.0.3"
    }
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
