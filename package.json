{
  "name": "homepage",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node src/build-publication.mjs",
    "check:tokens": "node scripts/audit-design.mjs",
    "check:product": "node --test src/*.test.mjs src/document/test/*.test.js",
    "dev": "npm run build:site && node src/serve.mjs --port 8796 --root dist/site",
    "build:site": "node src/build-publication.mjs",
    "content:sync-vault": "node src/approved-content.mjs sync-vault",
    "content:check": "node src/approved-content.mjs check"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@vscode/markdown-it-katex": "1.1.2",
    "@woonyong-choi/design-tokens": "github:woonyong-choi/design-tokens#cea257afac8d336fda1319377f447d38adb38d11",
    "diagramplay": "github:woonyong-choi/diagramplay#414d173038b1a49c268e766178ebb6a2fc895022",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "jsdom": "29.1.1",
    "katex": "^0.19.0",
    "markdown-it": "15.0.3",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "shiki": "4.5.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": {
      ".": "$katex",
      "commander": "14.0.3"
    }
  }
}
