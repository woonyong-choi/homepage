{
  "name": "homepage",
  "private": true,
  "type": "module",
  "imports": {
    "#design/*": "./src/design/dist/*"
  },
  "scripts": {
    "prepare": "node src/design/build/index.js",
    "build": "node src/design/build/index.js && node src/build/index.js",
    "dev": "npm run build && node src/build/serve.js",
    "test": "node src/design/build/index.js && node --test",
    "content:sync": "node src/vault/approved.js sync-vault",
    "content:check": "node src/vault/approved.js check"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@vscode/markdown-it-katex": "1.1.2",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "jsdom": "29.1.1",
    "katex": "^0.19.0",
    "markdown-it": "15.0.3",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "postcss": "^8.5.29",
    "purgecss": "^7.0.2",
    "shiki": "4.5.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": {
      ".": "$katex",
      "commander": "14.0.3"
    }
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
