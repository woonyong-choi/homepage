    "diagramplay": "github:woonyong-choi/diagramplay#0a44d42eef40b7ecbf3121d34d9b1b1920b053aa",
    "document-engine": "github:woonyong-choi/document-engine#c3ce65e3324eb1c408e11a85bd01ef6bd9654779",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "katex": "^0.19.0",
    "yaml": "2.9.1"
  },
  "overrides": {
